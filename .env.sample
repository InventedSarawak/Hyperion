# ------------------------------------------------------------------------------
# Hyperion — environment sample
#
# Copy to `.env` at the repo root and fill in what you have:
#     cp .env.sample .env
#
# `.env` is gitignored. Every source is OPTIONAL: siphon activates a source only
# when its adapter exists AND its credential (if any) is present. On startup
# siphon logs each source as ACTIVE or inactive-with-reason, so you always know
# what is actually being pulled.
#
# Legend:  [no key]  works without credentials
#          [key]     needs a credential to activate
#          [planned] adapter not implemented yet; config is here for when it is
# ------------------------------------------------------------------------------


# ==============================================================================
# Global siphon settings
# ==============================================================================

# How often each active source is polled. Format: Go duration (30s, 10m, 1h).
SIPHON_POLL_INTERVAL=10m

# How far back the first poll reaches. Format: Go duration.
# NVD caps any single query window at 120 days — larger values are clamped.
SIPHON_LOOKBACK=2h


# ==============================================================================
# 1. NVD — National Vulnerability Database                       [no key] IMPLEMENTED
#    Docs:     https://nvd.nist.gov/developers/vulnerabilities
#    Get key:  https://nvd.nist.gov/developers/request-an-api-key  (free, instant)
#    Limits:   5 req / 30s rolling window without a key
#              50 req / 30s rolling window with a key
#    Notes:    Works with no key, but the key is strongly recommended. siphon
#              paces requests automatically (6s without a key, 0.6s with one)
#              and retries throttled responses with exponential backoff.
# ==============================================================================

SIPHON_NVD_ENABLED=true

# Format: 36-char UUID, e.g. 12345678-1234-1234-1234-123456789abc
SIPHON_NVD_API_KEY=

# Override only for testing against a mock. Format: absolute URL.
SIPHON_NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# Results per request. Format: integer, max 2000 (the API's hard ceiling).
SIPHON_NVD_PAGE_SIZE=2000

# Pages to walk per poll. Format: integer; 0 = unlimited (drain everything).
SIPHON_NVD_MAX_PAGES=5


# ==============================================================================
# 2. GitHub Advisory Database                                       [key] [planned]
#    Docs:    https://docs.github.com/en/rest/security-advisories/global-advisories
#    Token:   https://github.com/settings/tokens  (classic or fine-grained;
#             public advisories need no scopes)
#    Limits:  60 req/hour unauthenticated, 5,000 req/hour with a token
#             (GraphQL: 5,000 points/hour)
# ==============================================================================

SIPHON_GITHUB_ENABLED=true

# Format: ghp_xxxxxxxx (classic) or github_pat_xxxxxxxx (fine-grained)
SIPHON_GITHUB_TOKEN=

SIPHON_GITHUB_BASE_URL=https://api.github.com


# ==============================================================================
# 3. CISA KEV — Known Exploited Vulnerabilities                  [no key] [planned]
#    Docs:    https://www.cisa.gov/known-exploited-vulnerabilities-catalog
#    Limits:  none published; it is a single static JSON file (~1.6 MB).
#    Notes:   Poll at most hourly — the catalog updates roughly daily.
# ==============================================================================

SIPHON_CISA_KEV_ENABLED=true
SIPHON_CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json


# ==============================================================================
# 4. Exploit-DB                                                  [no key] [planned]
#    Docs:    https://gitlab.com/exploit-database/exploitdb
#    Limits:  none published; a CSV in the public GitLab mirror (~10 MB).
#    Notes:   There is no official REST API. Poll daily at most; prefer a
#             conditional request (ETag / If-Modified-Since) over refetching.
# ==============================================================================

SIPHON_EXPLOITDB_ENABLED=true
SIPHON_EXPLOITDB_CSV_URL=https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv


# ==============================================================================
# 5. MITRE CVE List                                              [no key] [planned]
#    Docs:    https://cveawg.mitre.org/api-docs/
#    Limits:  none published for read endpoints; be conservative.
#    Notes:   Read access is anonymous. Credentials are only needed to *submit*
#             CVE records as a CNA, which Hyperion does not do.
# ==============================================================================

SIPHON_MITRE_ENABLED=true
SIPHON_MITRE_BASE_URL=https://cveawg.mitre.org/api


# ==============================================================================
# 6. Vendor Security Advisories                        [no key / key] [planned]
#    Red Hat:  https://docs.redhat.com/en/documentation/red_hat_security_data_api
#              public, no key, be polite (<= 1 req/sec)
#    MSRC:     https://api.msrc.microsoft.com/  — anonymous works; a key raises
#              limits. Format: 32-char hex subscription key.
# ==============================================================================

SIPHON_VENDOR_ENABLED=true
SIPHON_VENDOR_REDHAT_BASE_URL=https://access.redhat.com/hydra/rest/securitydata
SIPHON_VENDOR_MSRC_BASE_URL=https://api.msrc.microsoft.com/cvrf/v3.0

# Format: 32-char hex string. Leave empty to use anonymous access.
SIPHON_VENDOR_MSRC_API_KEY=


# ==============================================================================
# 7. OSINT & Mailing Lists                                       [no key] [planned]
#    Full Disclosure RSS: https://seclists.org/rss/fulldisclosure.rss
#    Limits:  none published; these are plain RSS/Atom files.
#    Notes:   Be a good citizen — poll every 15m+ and send If-Modified-Since.
# ==============================================================================

SIPHON_OSINT_ENABLED=true

# Format: comma-separated list of absolute feed URLs.
SIPHON_OSINT_RSS_FEEDS=https://seclists.org/rss/fulldisclosure.rss


# ==============================================================================
# 8. Package Manager Feeds (npm / PyPI / RubyGems)               [no key] [planned]
#    npm:      https://github.com/npm/registry/blob/master/docs/REGISTRY-API.md
#    PyPI:     https://docs.pypi.org/api/json/   (no key; heavy use should
#              prefer the BigQuery/dataset exports over hammering the API)
#    RubyGems: https://guides.rubygems.org/rubygems-org-api/
#    Limits:   npm/RubyGems ask for reasonable use; PyPI throttles aggressive
#              clients. Cache with ETags and poll slowly.
# ==============================================================================

SIPHON_PACKAGE_FEEDS_ENABLED=true
SIPHON_PACKAGE_NPM_BASE_URL=https://registry.npmjs.org
SIPHON_PACKAGE_PYPI_BASE_URL=https://pypi.org/pypi
SIPHON_PACKAGE_RUBYGEMS_BASE_URL=https://rubygems.org/api/v1

# Format: comma-separated ecosystem names. Supported: npm, pypi, rubygems
SIPHON_PACKAGE_ECOSYSTEMS=npm,pypi


# ==============================================================================
# 9. Shodan (internet exposure enrichment)                          [key] [planned]
#    Docs:    https://developer.shodan.io/api
#    Key:     https://account.shodan.io/  (PAID — no usable free tier for this)
#    Limits:  ~1 request/second; query credits are consumed per search.
#    Notes:   Stays inactive without a key. Censys is a possible alternative:
#             https://search.censys.io/api
# ==============================================================================

SIPHON_SHODAN_ENABLED=true

# Format: 32-char alphanumeric string.
SIPHON_SHODAN_API_KEY=

SIPHON_SHODAN_BASE_URL=https://api.shodan.io


# ==============================================================================
# 10. GSD / OSV — Global Security Database                       [no key] [planned]
#     Docs:    https://google.github.io/osv.dev/api/
#     Limits:  none currently documented; 32 MiB response cap on HTTP/1.1.
#     Notes:   OSV.dev is the practical, actively-served endpoint for this
#              community dataset (GSD itself is distributed as a git repo).
# ==============================================================================

SIPHON_GSD_ENABLED=true
SIPHON_GSD_BASE_URL=https://api.osv.dev/v1


# ==============================================================================
# cortex — intelligence service (storage + search + gRPC API)
# ==============================================================================

# Postgres DSN. Host port is 5433 in deploy/docker-compose.yml (5432 is often
# taken by a local Postgres install). Format: postgres://user:pass@host:port/db
CORTEX_DATABASE_URL=postgres://hyperion:hyperion@localhost:5433/hyperion?sslmode=disable

# Elasticsearch base URL. Format: absolute URL.
# If unreachable, cortex still ingests and stores — only search is disabled.
CORTEX_ELASTICSEARCH_URL=http://localhost:9200

# Index name for vulnerability documents.
CORTEX_INDEX_NAME=hyperion-vulnerabilities

# gRPC listen address for the intelligence API. Format: [host]:port
CORTEX_GRPC_ADDR=:50051

# Serve the gRPC API. Format: true/false
CORTEX_SERVE_GRPC=true

# Read SignalDiscovered events from stdin instead of serving gRPC (used when
# piping siphon into cortex: `siphon | cortex`). Format: true/false
CORTEX_CONSUME_STDIN=false


# ==============================================================================
# nexus — API gateway (GraphQL)
# ==============================================================================

# HTTP listen address. GraphQL at POST /graphql, console at GET /playground.
NEXUS_HTTP_ADDR=:8080

# Where cortex's gRPC API lives. Format: host:port
NEXUS_CORTEX_GRPC_ADDR=localhost:50051
