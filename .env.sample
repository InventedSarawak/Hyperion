# Hyperion environment. Copy to .env (gitignored) and fill in what you have:
#   cp .env.sample .env
#
# Config is namespaced per microservice: SERVICE.VAR -> SERVICE_VAR.
# A real environment variable always beats this file, so one-off overrides work:
#   SIPHON_LOOKBACK=24h go run ./cmd/worker
# Every source works WITHOUT a key. Keys only raise rate limits (NVD, GitHub).
# On startup siphon logs each source as ACTIVE or INACTIVE with the reason.

# ==============================================================================
# siphon — ingestion worker
# ==============================================================================

SIPHON_POLL_INTERVAL=10m          # Go duration: 30s, 10m, 1h
SIPHON_LOOKBACK=2h                # Go duration; NVD clamps any window to 120d

# --- 1. NVD ---------------------------------------------- key: OPTIONAL (free)
# Get: https://nvd.nist.gov/developers/request-an-api-key
# Limits: 5 req/30s without key, 50 req/30s with. Docs: https://nvd.nist.gov/developers/vulnerabilities
SIPHON_NVD_ENABLED=true
SIPHON_NVD_API_KEY=               # format: UUID, 8-4-4-4-12 hex
SIPHON_NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
SIPHON_NVD_PAGE_SIZE=2000         # int, max 2000
SIPHON_NVD_MAX_PAGES=5            # int; 0 = unlimited

# --- 2. GitHub Advisory ---------------------------------- key: OPTIONAL (free)
# Get: https://github.com/settings/tokens  (public advisories need no scopes)
# Limits: 60 req/h without token, 5000 req/h with.
SIPHON_GITHUB_ENABLED=true
SIPHON_GITHUB_TOKEN=              # format: ghp_... or github_pat_...
SIPHON_GITHUB_BASE_URL=https://api.github.com

# --- 3. CISA KEV ------------------------------------------------ key: NOT NEEDED
# Public JSON catalog (~1.6 MB), updates ~daily.
SIPHON_CISA_KEV_ENABLED=true
SIPHON_CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# --- 4. Exploit-DB ---------------------------------------------- key: NOT NEEDED
# Public CSV in the GitLab mirror (~10 MB). Only rows citing a CVE are ingested.
SIPHON_EXPLOITDB_ENABLED=true
SIPHON_EXPLOITDB_CSV_URL=https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv

# --- 5. MITRE CVE List ------------------------------------------ key: NOT NEEDED
# Public CVE Services API; a small delta.json drives incremental polling.
SIPHON_MITRE_ENABLED=true
SIPHON_MITRE_BASE_URL=https://cveawg.mitre.org/api

# --- 6. Vendor Advisories --------------------------- key: NOT NEEDED (MSRC opt.)
# Red Hat Security Data API is public. MSRC serves anonymously; a key raises limits.
SIPHON_VENDOR_ENABLED=true
SIPHON_VENDOR_REDHAT_BASE_URL=https://access.redhat.com/hydra/rest/securitydata
SIPHON_VENDOR_MSRC_BASE_URL=https://api.msrc.microsoft.com/cvrf/v3.0
SIPHON_VENDOR_MSRC_API_KEY=       # format: 32-char hex; optional

# --- 7. OSINT / Mailing Lists ----------------------------------- key: NOT NEEDED
# RSS/Atom feeds. Only items mentioning a CVE are ingested.
SIPHON_OSINT_ENABLED=true
SIPHON_OSINT_RSS_FEEDS=https://seclists.org/rss/fulldisclosure.rss   # comma-separated URLs

# --- 8. Package Feeds ------------------------------------------- key: NOT NEEDED
# Resolves watched packages against OSV.dev — drives blast radius.
SIPHON_PACKAGE_FEEDS_ENABLED=true
SIPHON_PACKAGE_OSV_BASE_URL=https://api.osv.dev/v1
SIPHON_PACKAGE_WATCHLIST=npm:lodash,npm:express,PyPI:django,PyPI:requests   # <ecosystem>:<package>

# --- 9. Shodan --------------------------------------------------- key: NOT NEEDED
# Uses the FREE CVEDB (https://cvedb.shodan.io) for EPSS + KEV enrichment.
# api.shodan.io (host search) needs a PAID key and is not used here.
SIPHON_SHODAN_ENABLED=true
SIPHON_SHODAN_BASE_URL=https://cvedb.shodan.io
SIPHON_SHODAN_API_KEY=            # format: 32-char alphanumeric; optional, unused by CVEDB

# --- 10. GSD / OSV ----------------------------------------------- key: NOT NEEDED
# Community dataset served via OSV.dev.
SIPHON_GSD_ENABLED=true
SIPHON_GSD_BASE_URL=https://api.osv.dev/v1

# ==============================================================================
# cortex — intelligence service (storage + search + gRPC)
# ==============================================================================

CORTEX_DATABASE_URL=postgres://hyperion:hyperion@localhost:5433/hyperion?sslmode=disable
CORTEX_ELASTICSEARCH_URL=http://localhost:9200   # unreachable -> ingest continues, search off
CORTEX_INDEX_NAME=hyperion-vulnerabilities
CORTEX_GRPC_ADDR=:50051           # [host]:port
CORTEX_SERVE_GRPC=true            # true/false
CORTEX_CONSUME_STDIN=false        # true when piping: siphon | cortex

# ==============================================================================
# nexus — API gateway (GraphQL)
# ==============================================================================

NEXUS_HTTP_ADDR=:8080             # POST /graphql, console at GET /playground
NEXUS_CORTEX_GRPC_ADDR=localhost:50051
