# Hyperion environment. Copy to .env (gitignored) and fill in what you have:
#   cp .env.sample .env
#
# Config is namespaced per microservice: SERVICE.VAR -> SERVICE_VAR.
# A real environment variable always beats this file, so one-off overrides work:
#   SIPHON_LOOKBACK=24h go run ./cmd/worker
# Every source works WITHOUT a key. Keys only raise rate limits (NVD, GitHub).
# On startup siphon logs each source as ACTIVE or INACTIVE with the reason.

# ==============================================================================
# siphon — ingestion worker
# ==============================================================================

SIPHON_LOG_LEVEL=info             # debug names every signal as it is published

# --- Polling cadence ----------------------------------------------------------
# Each source has its own interval and first-poll window, because the ten feeds
# publish at rates that differ by orders of magnitude. The defaults are below;
# override one feed with SIPHON_<SOURCE>_INTERVAL / _LOOKBACK.
#
#   nvd, mitre          every 10m, first window 2h
#   github_advisory     every 15m, first window 12h   (reviewed advisories are rare)
#   gsd, shodan         every 30m, first window 24h
#   cisa_kev, vendor    every 1h,  first window 48h
#   osint               every 2h,  first window 7d
#   exploitdb, package  every 6h,  first window 14d   (a few records a week)
#
# SIPHON_NVD_INTERVAL=5m
# SIPHON_EXPLOITDB_LOOKBACK=30d
#
# Setting either of these overrides EVERY source at once, which is what you want
# for a deliberate catch-up and not much else. Leave them unset for per-source
# cadence. NVD clamps any window to 120 days.
# SIPHON_POLL_INTERVAL=10m
# SIPHON_LOOKBACK=2h

# --- Ingestion watermark ------------------------------------------------------
# How far ingestion has read, stored in Redis so a restart resumes instead of
# re-reading SIPHON_LOOKBACK. Off, or Redis unreachable, means in-memory only:
# a restart re-reads the window, and an outage longer than it skips records.
SIPHON_CHECKPOINT_ENABLED=true    # true/false
SIPHON_REDIS_ADDR=localhost:6379

# --- Dedupe -------------------------------------------------------------------
# Suppresses republishing an observation that has not changed. Keyed on a
# fingerprint of the signal's content, so a corrected score or a newly named
# affected package IS published; only identical re-observations are dropped.
# NOTE: after wiping cortex's databases, clear these keys (redis-cli --scan
# --pattern 'hyperion:siphon:seen:*' | xargs redis-cli DEL) or run a backfill,
# or siphon will not republish what it already sent.
SIPHON_DEDUPE_ENABLED=true        # true/false
SIPHON_DEDUPE_WINDOW=24h          # Go duration; how long an observation is remembered

# --- Transport: where published events go -------------------------------------
# On (the default): events go to Kafka, and cortex reads them from there.
# Off: events go to stdout — what `task ingest` and `task backfill` pipe into
# cortex, and they set it themselves.
# A broker that is configured but unreachable is fatal, not a silent fallback.
SIPHON_KAFKA_ENABLED=true         # true/false
SIPHON_KAFKA_BROKERS=localhost:9092   # comma-separated seed list
SIPHON_KAFKA_TOPIC=hyperion.signals.v1
SIPHON_KAFKA_PARTITIONS=6         # int; used only when the topic has to be created
# Repository manifest reads go here instead of a gRPC call to cortex, so a scan
# no longer fails when cortex is restarting. Falls back to gRPC if the broker is
# unreachable — scanning is siphon's secondary job, and gRPC is how v2 did it.
SIPHON_KAFKA_DEPENDENCY_TOPIC=hyperion.dependencies.v1

# --- 1. NVD ---------------------------------------------- key: OPTIONAL (free)
# Get: https://nvd.nist.gov/developers/request-an-api-key
# Limits: 5 req/30s without key, 50 req/30s with. Docs: https://nvd.nist.gov/developers/vulnerabilities
SIPHON_NVD_ENABLED=true
SIPHON_NVD_API_KEY=               # format: UUID, 8-4-4-4-12 hex
SIPHON_NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
SIPHON_NVD_PAGE_SIZE=2000         # int, max 2000
SIPHON_NVD_MAX_PAGES=5            # int; 0 = unlimited

# --- 2. GitHub Advisory ---------------------------------- key: OPTIONAL (free)
# Get: https://github.com/settings/tokens  (public advisories need no scopes)
# Limits: 60 req/h without token, 5000 req/h with.
SIPHON_GITHUB_ENABLED=true
SIPHON_GITHUB_TOKEN=              # format: ghp_... or github_pat_...
SIPHON_GITHUB_BASE_URL=https://api.github.com

# --- 3. CISA KEV ------------------------------------------------ key: NOT NEEDED
# Public JSON catalog (~1.6 MB), updates ~daily.
SIPHON_CISA_KEV_ENABLED=true
SIPHON_CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# --- 4. Exploit-DB ---------------------------------------------- key: NOT NEEDED
# Public CSV in the GitLab mirror (~10 MB). Only rows citing a CVE are ingested.
SIPHON_EXPLOITDB_ENABLED=true
SIPHON_EXPLOITDB_CSV_URL=https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv

# --- 5. MITRE CVE List ------------------------------------------ key: NOT NEEDED
# Public CVE Services API; a small delta.json drives incremental polling.
SIPHON_MITRE_ENABLED=true
SIPHON_MITRE_BASE_URL=https://cveawg.mitre.org/api

# --- 6. Vendor Advisories --------------------------- key: NOT NEEDED (MSRC opt.)
# Red Hat Security Data API is public. MSRC serves anonymously; a key raises limits.
SIPHON_VENDOR_ENABLED=true
SIPHON_VENDOR_REDHAT_BASE_URL=https://access.redhat.com/hydra/rest/securitydata
SIPHON_VENDOR_MSRC_BASE_URL=https://api.msrc.microsoft.com/cvrf/v3.0
SIPHON_VENDOR_MSRC_API_KEY=       # format: 32-char hex; optional

# --- 7. OSINT / Mailing Lists ----------------------------------- key: NOT NEEDED
# RSS/Atom feeds. Only items mentioning a CVE are ingested.
SIPHON_OSINT_ENABLED=true
SIPHON_OSINT_RSS_FEEDS=https://seclists.org/rss/fulldisclosure.rss   # comma-separated URLs

# --- 8. Package Feeds ------------------------------------------- key: NOT NEEDED
# Resolves watched packages against OSV.dev — drives blast radius.
SIPHON_PACKAGE_FEEDS_ENABLED=true
SIPHON_PACKAGE_OSV_BASE_URL=https://api.osv.dev/v1
SIPHON_PACKAGE_WATCHLIST=npm:lodash,npm:express,PyPI:django,PyPI:requests   # <ecosystem>:<package>
# The backfill (`task backfill`) reads OSV's full per-ecosystem exports instead.
SIPHON_PACKAGE_OSV_BULK_BASE_URL=https://osv-vulnerabilities.storage.googleapis.com
SIPHON_PACKAGE_OSV_BULK_ECOSYSTEMS=npm,PyPI,Go,Maven,crates.io,RubyGems,NuGet,Packagist

# --- 9. Shodan --------------------------------------------------- key: NOT NEEDED
# Uses the FREE CVEDB (https://cvedb.shodan.io) for EPSS + KEV enrichment.
# api.shodan.io (host search) needs a PAID key and is not used here.
SIPHON_SHODAN_ENABLED=true
SIPHON_SHODAN_BASE_URL=https://cvedb.shodan.io
SIPHON_SHODAN_API_KEY=            # format: 32-char alphanumeric; optional, unused by CVEDB

# --- 10. GSD / OSV ----------------------------------------------- key: NOT NEEDED
# Community dataset served via OSV.dev.
SIPHON_GSD_ENABLED=true
SIPHON_GSD_BASE_URL=https://api.osv.dev/v1

# --- Repository scan (supply chain) ------------- key: OPTIONAL but RECOMMENDED
# Reads go.mod / package.json from tracked repos and reports them to cortex,
# which builds the dependency graph that blast radius traverses.
# WHICH repositories is not configured here: add them in deck's Repositories
# tab (4). The list lives in cortex and siphon polls it.
# Reuses SIPHON_GITHUB_TOKEN above. Unauthenticated GitHub allows only 60
# requests/hour, and each repository costs ~3 — so a token is worth having.
SIPHON_REPO_SCAN_ENABLED=true
SIPHON_REPO_WATCH_INTERVAL=30s    # Go duration; how soon a newly added repo is scanned
SIPHON_REPO_SCAN_INTERVAL=6h      # Go duration; how long a scan stays fresh
SIPHON_REPO_RETRY_INTERVAL=15m    # Go duration; how long a failed scan waits to retry
SIPHON_REPO_ORG_LIMIT=20          # int; per-owner cap for one-off `task scan -- -orgs x`
SIPHON_CORTEX_GRPC_ADDR=localhost:50051

# ==============================================================================
# cortex — intelligence service (storage + search + gRPC)
# ==============================================================================

CORTEX_DATABASE_URL=postgres://hyperion:hyperion@localhost:5432/hyperion?sslmode=disable
CORTEX_ELASTICSEARCH_URL=http://localhost:9200   # unreachable -> ingest continues, search off
CORTEX_INDEX_NAME=hyperion-vulnerabilities
CORTEX_GRPC_ADDR=:50051           # [host]:port
CORTEX_SERVE_GRPC=true            # true/false
CORTEX_CONSUME_STDIN=false        # true when piping: siphon | cortex (wins over KAFKA_ENABLED)
CORTEX_INGEST_WORKERS=8           # int; events ingested concurrently (backfill throughput)
CORTEX_INGEST_PROGRESS_EVERY=1000  # int; findings between "ingest progress" lines (0 silences them)
CORTEX_LOG_LEVEL=info             # debug names every finding as it lands
# How many findings a live watcher (deck, or anything on nexus /stream) can fall
# behind by before it starts missing them. Ingest never waits for a watcher.
CORTEX_STREAM_BUFFER=256          # int

# --- Transport: where ingested events come from -------------------------------
# On (the default): cortex consumes the signal topic while it serves the gRPC
# API. CORTEX_CONSUME_STDIN takes precedence when set. Records are
# keyed by finding id, so every report of one CVE is merged in order by one
# consumer; concurrency comes from the partitions, not CORTEX_INGEST_WORKERS.
# Members of one group share the partitions; a different group would read the
# same records again, independently.
CORTEX_KAFKA_ENABLED=true         # true/false
CORTEX_KAFKA_BROKERS=localhost:9092   # comma-separated seed list
CORTEX_KAFKA_TOPIC=hyperion.signals.v1
CORTEX_KAFKA_GROUP=intel-indexer
CORTEX_KAFKA_PARTITIONS=6         # int; used only when the topic has to be created

# A record that exhausts its retries is set aside here and ingest continues, so
# one bad record cannot block every record behind it on its partition. But a run
# of failures is the world being broken, not the records: after this many in a
# row, cortex stops instead of draining the topic into the dead-letter queue.
# Read them with `task topic:dlq`; put them back with `task topic:dlq -- -replay`.
CORTEX_KAFKA_DLQ_ENABLED=true     # true/false
CORTEX_KAFKA_DLQ_TOPIC=           # blank: <CORTEX_KAFKA_TOPIC>.dlq
CORTEX_KAFKA_DLQ_MAX_CONSECUTIVE=10   # int; stop after this many in a row

# Repository manifest reads, on their own topic and consumer group: a backlog of
# advisories must not hold up the supply-chain graph, and vice versa.
CORTEX_KAFKA_DEPENDENCY_TOPIC=hyperion.dependencies.v1
CORTEX_KAFKA_DEPENDENCY_GROUP=intel-graph

# GitHub lets the Repositories tab list a user's or org's repositories.
# Optional, but anonymous listing shares a 60 requests/hour budget.
CORTEX_GITHUB_TOKEN=              # format: ghp_... or github_pat_...; can be SIPHON_GITHUB_TOKEN's value
CORTEX_GITHUB_BASE_URL=https://api.github.com

# Redis backs alert deduplication. Unreachable -> alerts still fire, but a
# repeat within the window is no longer suppressed.
CORTEX_REDIS_ADDR=localhost:6379
CORTEX_ALERT_DEDUPE_WINDOW=1h     # Go duration; don't alert twice inside this
CORTEX_SUBSCRIPTION_INDEX=hyperion-subscriptions

# Neo4j backs the dependency graph and blast radius. Unreachable or unset ->
# the graph is disabled and vulnerability ingest continues unaffected.
CORTEX_NEO4J_URI=bolt://localhost:7687
CORTEX_NEO4J_USERNAME=neo4j
CORTEX_NEO4J_PASSWORD=hyperion
CORTEX_NEO4J_DATABASE=neo4j       # community edition serves a single database
CORTEX_BLAST_RADIUS_MAX_DEPTH=5   # int; hops of DEPENDS_ON to traverse

# Set to 0 to have `task up` skip the continuous siphon -> cortex ingest loop.
# HYPERION_INGEST=0

# ==============================================================================
# deck — terminal UI (Bubble Tea)
# ==============================================================================

# Transport: "gateway" (default) routes through nexus, so deck is subject to the
# same edge policy as every other client. "grpc" talks to cortex directly and is
# for debugging a cortex the gateway cannot reach.
DECK_TRANSPORT=gateway
DECK_GATEWAY_URL=http://localhost:8080/graphql
DECK_CORTEX_GRPC_ADDR=localhost:50051   # used only when DECK_TRANSPORT=grpc
# Empty = the live feed, newest first. A term opens on a best-match search
# instead; either way / changes it in the UI and s toggles best match / newest.
DECK_FEED_QUERY=
DECK_REFRESH_INTERVAL=30s         # Go duration; the feed polls (streaming is v3)
DECK_PAGE_SIZE=25                 # int, max 200
DECK_BLAST_RADIUS_MAX_DEPTH=3     # int; hops the graph explorer walks

# ==============================================================================
# nexus — API gateway (GraphQL)
# ==============================================================================

NEXUS_HTTP_ADDR=:8080             # POST /graphql, console at GET /playground
NEXUS_CORTEX_GRPC_ADDR=localhost:50051
